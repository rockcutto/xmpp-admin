# XMPP Admin
# Native/systemd deployment:
ADMIN_LISTEN=127.0.0.1:8090
# Docker: override with ADMIN_LISTEN=0.0.0.0:8090 inside the container,
# while publishing the host port only on 127.0.0.1.
ADMIN_BASE_PATH=/xmpp-admin
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Usually auto-detected on Ubuntu/Debian.
EJABBERD_CONFIG=/etc/ejabberd/ejabberd.yml

# Optional override for multi-vhost installations.
# XMPP_DOMAIN=example.org

# Usually auto-detected from ejabberd.yml when mod_http_api is configured.
# EJABBERD_API=http://127.0.0.1:5281/api

# Dedicated ejabberd account permitted to call only the required API commands.
EJABBERD_API_USER=xmpp-admin@example.org
EJABBERD_API_PASSWORD=replace-with-a-long-random-password
